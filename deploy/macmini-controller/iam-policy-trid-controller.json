{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeS1Jobs",
      "Effect": "Allow",
      "Action": "sagemaker:DescribeTrainingJob",
      "Resource": "arn:aws:sagemaker:ap-northeast-2:148761639313:training-job/trid-pt-s1-*"
    },
    {
      "Sid": "ListJobsToFindTheRunningJobOfARun",
      "Effect": "Allow",
      "Action": "sagemaker:ListTrainingJobs",
      "Resource": "*"
    },
    {
      "Sid": "ReadS1Outputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::trid-training-148761639313/corpus/runs/s1/*"
    },
    {
      "Sid": "ListS1Prefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::trid-training-148761639313",
      "Condition": {"StringLike": {"s3:prefix": ["corpus/runs/s1/*"]}}
    },
    {
      "Sid": "WriteOnlyTheControllerStatusObject",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::trid-training-148761639313/corpus/runs/s1/controller-status.json"
    }
  ]
}
